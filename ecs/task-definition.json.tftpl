{
  "family": ${jsonencode(family)},
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": ${jsonencode(execution_role_arn)},
  "containerDefinitions": [
    {
      "name": "app",
      "image": ${jsonencode(image)},
      "essential": true,
      "cpu": 128,
      "memoryReservation": 256,
      "memory": 384,
      "user": "10001:10001",
      "portMappings": [{"containerPort": 3000, "hostPort": 3000, "protocol": "tcp"}],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": ${jsonencode(log_group)},
          "awslogs-region": ${jsonencode(region)},
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
