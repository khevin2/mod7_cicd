server {
    listen 80;
    server_name {{ jenkins_server_name }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ jenkins_acme_webroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{ jenkins_server_name }};
    ssl_certificate /etc/letsencrypt/live/{{ jenkins_server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ jenkins_server_name }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /github-webhook/ {
        include /etc/nginx/conf.d/github-webhook-allowlist.conf;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
{% for cidr in jenkins_admin_cidrs %}
        allow {{ cidr }};
{% endfor %}
        deny all;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8080;
    }
}
