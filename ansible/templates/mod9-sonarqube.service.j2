[Unit]
Description=SonarQube for the memory-constrained CI demo
Requires=docker.service mod9-sonar-db.service
After=docker.service mod9-sonar-db.service network-online.target

[Service]
Restart=on-failure
RestartSec=15
# The attached Docker client returned 130 after the observed graceful shutdown.
SuccessExitStatus=130
TimeoutStartSec=120
TimeoutStopSec=180
LimitNOFILE=131072
LimitNPROC=8192
ExecStartPre=/usr/bin/docker exec mod9-ci-db pg_isready -h 127.0.0.1 -p 5432 -U sonar -d sonar -t 1
ExecStartPre=-/usr/bin/docker rm -f mod9-ci-sonar
ExecStart=/usr/bin/docker run --rm --name mod9-ci-sonar --network mod9-ci --log-opt max-size=10m --log-opt max-file=3 --ulimit nofile=131072:131072 --ulimit nproc=8192:8192 -p 127.0.0.1:9000:9000 --env-file /etc/mod9-ci/database.env -e SONAR_JDBC_URL=jdbc:postgresql://mod9-ci-db:5432/sonar -e SONAR_JDBC_MAXACTIVE=12 -e SONAR_JDBC_MINIDLE=2 -e "SONAR_WEB_JAVAOPTS=-Xms128m -Xmx256m" -e "SONAR_CE_JAVAOPTS=-Xms128m -Xmx256m" -e "SONAR_SEARCH_JAVAOPTS=-Xms512m -Xmx512m" -v mod9-ci-sonar-data:/opt/sonarqube/data -v mod9-ci-sonar-extensions:/opt/sonarqube/extensions -v mod9-ci-sonar-logs:/opt/sonarqube/logs {{ ci_sonar_image }}
ExecStop=/usr/bin/docker stop --time 120 mod9-ci-sonar

[Install]
WantedBy=multi-user.target
