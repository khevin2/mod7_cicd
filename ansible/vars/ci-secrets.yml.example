# Copy the values into an encrypted Ansible Vault file; never use this placeholder.
ci_jenkins_admin_password: "REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS"
# Add these for configure_ci_security.yml. Sonar passwords must be distinct,
# 16+ characters and include uppercase, lowercase, a number and a special character.
ci_sonar_admin_password: "REPLACE_WITH_YOUR_SONAR_ADMIN_PASSWORD"
ci_sonar_analysis_password: "REPLACE_WITH_A_DIFFERENT_ANALYSIS_ACCOUNT_PASSWORD"
ci_snyk_token: "REPLACE_WITH_YOUR_PRIVATE_SNYK_API_TOKEN"
