#!/usr/bin/env bash
set -Eeuo pipefail

readonly target=/etc/nginx/conf.d/github-webhook-allowlist.conf
tmp_json="$(mktemp)"
tmp_rules="$(mktemp)"
cleanup() { rm -f "$tmp_json" "$tmp_rules"; }
trap cleanup EXIT

curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
  --connect-timeout 10 --max-time 30 https://api.github.com/meta --output "$tmp_json"

jq --exit-status -r '.hooks[] | select(test("^[0-9.]+/[0-9]+$")) | "allow " + . + ";"' \
  "$tmp_json" > "$tmp_rules"
test -s "$tmp_rules"
printf '%s\\n' '# Managed by refresh-github-webhook-allowlist.' >> "$tmp_rules"
printf '%s\\n' 'deny all;' >> "$tmp_rules"

install -o root -g root -m 0644 "$tmp_rules" "$target.candidate"
nginx -t
mv -f "$target.candidate" "$target"
nginx -t
systemctl reload nginx

