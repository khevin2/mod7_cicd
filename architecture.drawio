    <diagram id="technical-design-target" name="Technical design">
        <mxGraphModel dx="493" dy="305" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
            <root>
