                    <mxGeometry x="245" y="125" width="900" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="p-checkout" value="2. Checkout&#xa;Pinned commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2f6690;fontColor=#1f2937;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
