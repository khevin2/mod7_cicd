                    <mxGeometry x="1230" y="230" width="165" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="td-jenkins" value="&lt;b&gt;Jenkins controller&lt;/b&gt;&#xa;Tests - validation - Trivy&#xa;Strict SSH deploy + rollback&#xa;No automatic cloud apply/destroy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d33833;strokeWidth=2;fontColor=#232f3e;fontSize=11;" parent="td-1" vertex="1">
                    <mxGeometry x="235" y="220" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="td-app" value="&lt;b&gt;Application EC2&lt;/b&gt;&#xa;Docker Express + OpenTelemetry - UID 10001&#xa;public :80 -&gt; app :3000&#xa;immutable digest + telemetry-preserving rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#3f7f5f;fontColor=#1f2937;fontSize=11;" parent="td-1" vertex="1">
                    <mxGeometry x="465" y="215" width="205" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="td-app-telemetry" value="&lt;b&gt;Private app telemetry&lt;/b&gt;&#xa;:9464 OpenMetrics RED + trace exemplars&#xa;OTLP/HTTP -&gt; monitoring :4318&#xa;JSON logs include trace_id + span_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2f6690;fontColor=#1f2937;fontSize=11;" parent="td-1" vertex="1">
                    <mxGeometry x="465" y="365" width="205" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="td-app-boundary" value="&lt;b&gt;Application SG&lt;/b&gt;&#xa;Public :80 only&#xa;private :9464/:9100 scrape path&#xa;private egress :4318 to monitoring VPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3f7f5f;dashed=1;fontColor=#31523d;fontSize=10;" parent="td-1" vertex="1">
                    <mxGeometry x="235" y="400" width="190" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="td-peering" value="Private VPC peering&#xa;two-way routes&#xa;non-transitive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f6b7a;dashed=1;fontColor=#374151;fontSize=9;" parent="td-1" vertex="1">
                    <mxGeometry x="680" y="330" width="75" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="td-edge-stack" value="&lt;b&gt;Nginx + Grafana&lt;/b&gt;&#xa;administrator HTTPS :443; internal Grafana :3000&#xa;Prometheus + Jaeger datasources; exemplar links&#xa;5xx &amp;gt;5% and p95 &amp;gt;300 ms for 10m&#xa;Ansible fingerprints startup provisioning and restarts only Grafana on drift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#f48120;fontColor=#5f3b00;fontSize=11;" parent="td-1" vertex="1">
                    <mxGeometry x="765" y="210" width="365" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="td-prometheus" value="&lt;b&gt;Prometheus&lt;/b&gt;&#xa;private; no public port; scrape/evaluate 15s&#xa;scrapes application + both Node Exporters&#xa;records RPS, p95, 5xx%&#xa;no alert definitions or notification routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebea;strokeColor=#c0392b;fontColor=#5c1f18;fontSize=11;" parent="td-1" vertex="1">
