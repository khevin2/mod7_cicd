                    <mxGeometry x="200" y="70" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="p-github" value="1. GitHub push&#xa;Webhook delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292f;strokeColor=#24292f;fontColor=#ffffff;fontSize=14;fontStyle=1;" parent="1" vertex="1">
