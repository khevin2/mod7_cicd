                <mxCell id="td-app-vpc" value="Application + Jenkins VPC - 10.70.0.0/16" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=14;fontStyle=1;fontColor=#205c33;strokeColor=#3f7f5f;strokeWidth=2;fillColor=#f5fbf7;dashed=1;" parent="td-1" vertex="1">
