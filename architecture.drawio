                <mxCell id="td-title" value="Project 6 observability and security technical design" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontColor=#16191f;fontSize=24;fontStyle=1;" parent="td-1" vertex="1">
                    <mxGeometry x="350" y="20" width="800" height="40" as="geometry"/>
