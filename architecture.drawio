                    <mxGeometry x="735" y="155" width="425" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="td-services" value="Managed AWS logging, security, and secret services" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=13;fontStyle=1;fontColor=#5f3b00;strokeColor=#b7791f;fillColor=#fffbf0;dashed=1;" parent="td-1" vertex="1">
                    <mxGeometry x="735" y="575" width="425" height="195" as="geometry"/>
