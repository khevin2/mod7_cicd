                <mxCell id="p-validate" value="3. Install + check&#xa;npm ci / syntax" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2f6690;fontColor=#1f2937;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
                    <mxGeometry x="200" y="95" width="135" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p-test" value="4. Test&#xa;Jest + JUnit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f3ec;strokeColor=#3f7f5f;fontColor=#1f2937;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
                    <mxGeometry x="365" y="95" width="135" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p-repo" value="5. Trivy repository&#xa;Block HIGH / CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#3d2c0d;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
                    <mxGeometry x="530" y="95" width="145" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p-build" value="6. Docker build&#xa;Non-root image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2f6690;fontColor=#1f2937;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
                    <mxGeometry x="705" y="95" width="145" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="p-image" value="7. Trivy image&#xa;Block HIGH / CRITICAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#3d2c0d;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
                    <mxGeometry x="705" y="265" width="145" height="75" as="geometry"/>
