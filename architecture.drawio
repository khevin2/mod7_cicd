                <mxCell id="p-push" value="8. Push GHCR&#xa;Immutable digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#2f6690;fontColor=#1f2937;fontSize=13;fontStyle=1;" parent="p-jenkins" vertex="1">
