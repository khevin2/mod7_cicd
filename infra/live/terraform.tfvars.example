# Copy to terraform.tfvars and replace each placeholder with approved values.
# The SSH public key is not secret; never place a private key in this file.
owner                  = "replace-with-owner"
# This public /32 permits administrator SSH and HTTPS access to Jenkins.
administrator_ssh_cidr = "203.0.113.10/32"
ssh_public_key_path    = "../../keys/jenkins-webapp-lab-ec2.pub"

# Set a distinct public key only when Jenkins administration must use a different key.
# jenkins_ssh_public_key_path = "../../keys/jenkins-controller.pub"
jenkins_instance_type            = "t3.micro"
jenkins_root_volume_size_gib     = 20
jenkins_allocate_elastic_ip      = false
enable_jenkins_http_ingress      = true
enable_jenkins_webhook_ingress   = false

# Monitoring, peering, and the existing application/Jenkins topology share this
# one Terraform state and are planned together.
grafana_admin_cidr = "203.0.113.10/32"
monitoring_enable_ssh = false
# monitoring_ssh_public_key_path = "../../keys/monitoring.pub"
enable_cross_vpc_private_dns = false
